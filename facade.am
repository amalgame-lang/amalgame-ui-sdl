namespace Amalgame.UI.SDL

// ═══════════════════════════════════════════════════════
//  facade.am — SDL2/SDL3 binding (v0.0.1-dev scaffold)
// ═══════════════════════════════════════════════════════
//
// Public surface (incrementally filled across v0.0.x):
//   - Window         create / show / close / size / title
//   - Event          Quit, mouse, keyboard, resize, text input
//   - Surface        Clear / FillRect / DrawLine / DrawText
//   - Color          RGBA primitive
//   - Rect           X/Y/W/H + intersect / contains
//   - Theme.DetectOS()  → "light" or "dark"
//
// Default backend is SDL2. Compile with -DAMALGAME_UI_USE_SDL3
// to use SDL3.
//
// Status v0.0.1-dev: only Theme.DetectOS() is wired. Window /
// Event / Surface land in v0.0.2.

@c {
    #include "Amalgame_UI.h"
}

public class Color {
    public R: int
    public G: int
    public B: int
    public A: int

    public Color(r: int, g: int, b: int, a: int) {
        this.R = r
        this.G = g
        this.B = b
        this.A = a
    }
}

public class Rect {
    public X: int
    public Y: int
    public W: int
    public H: int

    public Rect(x: int, y: int, w: int, h: int) {
        this.X = x
        this.Y = y
        this.W = w
        this.H = h
    }
}

public class Theme {
    // Returns "light" or "dark" — the host's current OS color scheme.
    // Falls back to "light" if detection fails.
    public static string DetectOS() {
        @c {
            return (code_string)Amalgame_UI_DetectOSTheme();
        }
    }
}
