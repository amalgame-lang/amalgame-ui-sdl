namespace Amalgame.UI.SDL

// ═══════════════════════════════════════════════════════
//  facade.am — SDL2/SDL3 binding (v0.0.2-dev)
// ═══════════════════════════════════════════════════════
//
// Public surface:
//   - Color (R/G/B/A)
//   - Rect  (X/Y/W/H)
//   - Theme.DetectOS()  → "light" or "dark"
//   - Window            create / close / size / title / event poll
//                       + draw primitives (clear / fill / line / text)
//   - Event             Kind/X/Y/Button/Mods/W/H + EventKind.* constants
//   - Font              load / destroy / measure
//
// Status: Window/Event/Font wired against runtime/Amalgame_UI.h.
// The retained-mode widget toolkit lives in the companion package
// amalgame-ui-forms.
//
// Implementation notes:
//   - Window and Font carry the underlying C pointer as an `int`
//     field (i64 at the C level) — facade methods cast it back to
//     AmalgameUIWindow* / AmalgameUIFont* inside @c blocks.
//   - Event is a plain data class with no C-side pointer; Poll
//     fills its fields via a stack-allocated AmalgameUIEvent.

@c {
    #include "Amalgame_UI.h"
}

// ─── Primitives ────────────────────────────────────────

// Color and Rect carry their components as public fields, but
// consumer code reads them through Get* methods — the cgen
// forward-declares external structs as `incomplete typedef`s
// in consumer translation units, and direct field access on an
// incomplete typedef is rejected by gcc. Internal facade code
// (the methods below + Window/Font in this file) still uses
// `self->R` style since the struct is complete there.

public class Color {
    public R: int
    public G: int
    public B: int
    public A: int

    public Color(r: int, g: int, b: int, a: int) {
        this.R = r
        this.G = g
        this.B = b
        this.A = a
    }

    public int GetR() { return this.R }
    public int GetG() { return this.G }
    public int GetB() { return this.B }
    public int GetA() { return this.A }
}

public class Rect {
    public X: int
    public Y: int
    public W: int
    public H: int

    public Rect(x: int, y: int, w: int, h: int) {
        this.X = x
        this.Y = y
        this.W = w
        this.H = h
    }

    public int GetX() { return this.X }
    public int GetY() { return this.Y }
    public int GetW() { return this.W }
    public int GetH() { return this.H }
}

// ─── OSTheme ───────────────────────────────────────────
//
// Named `OSTheme` (not `Theme`) so consumers can `import
// Amalgame.UI.SDL` without colliding with a richer `Theme`
// class that owns colour palettes — e.g. the one shipped by
// amalgame-ui-forms. The resolver currently rejects fully
// qualified namespace paths (`Amalgame.UI.SDL.Theme.X()`),
// so this rename is the path of least surprise.

public class OSTheme {
    // Returns "light" or "dark" — the host's current OS color
    // scheme. Probes:
    //   macOS:   `defaults read -g AppleInterfaceStyle`
    //   Windows: HKCU\…\Themes\Personalize\AppsUseLightTheme
    //   Linux:   `gsettings get org.gnome.desktop.interface color-scheme`,
    //            falls back to $GTK_THEME
    // Cached after first call.
    public static string DetectOS() {
        @c {
            return (code_string)Amalgame_UI_DetectOSTheme();
        }
    }
}

// ─── EventKind constants ───────────────────────────────
//
// Exposed as static getters rather than fields because the
// bootstrap doesn't accept field initialisers on static slots.
// Callers write `EventKind.QUIT()` to read the value — one set
// of parens cheaper than the alternative (algebraic enum +
// pattern match on every event).

public class EventKind {
    public static int NONE()          { return 0 }
    public static int QUIT()          { return 1 }
    public static int MOUSE_DOWN()    { return 2 }
    public static int MOUSE_UP()      { return 3 }
    public static int MOUSE_MOVE()    { return 4 }
    public static int KEY_DOWN()      { return 5 }
    public static int KEY_UP()        { return 6 }
    public static int TEXT_INPUT()    { return 7 }
    public static int WINDOW_RESIZE() { return 8 }
}

// ─── Event ─────────────────────────────────────────────

public class Event {
    public Kind: int     // see EventKind.*
    public X: int        // mouse coords (kind 2..4)
    public Y: int
    public Button: int   // mouse button id, or SDL keycode for kind 5/6
    public Mods: int     // keyboard modifier bitmask
    public W: int        // resize width  (kind 8)
    public H: int        // resize height (kind 8)

    public Event() {
        this.Kind = 0
        this.X = 0
        this.Y = 0
        this.Button = 0
        this.Mods = 0
        this.W = 0
        this.H = 0
    }

    // Consumer-facing getters — see the Color/Rect note above
    // for why direct field access from outside the facade .c
    // doesn't compile.
    public int GetKind()   { return this.Kind }
    public int GetX()      { return this.X }
    public int GetY()      { return this.Y }
    public int GetButton() { return this.Button }
    public int GetMods()   { return this.Mods }
    public int GetW()      { return this.W }
    public int GetH()      { return this.H }

    // Setters — used by Window.Poll/Wait to populate the Event
    // from the runtime's flat AmalgameUIEvent payload. Direct
    // `ev->Field` writes in @c blocks blow up when the cgen
    // forward-declares Event in another translation unit
    // (combined `amc -o test.am facade.am` mode); going through
    // a setter sidesteps the incomplete-typedef issue because
    // gcc only needs the function signature.
    public void SetKind(v: int)   { this.Kind = v }
    public void SetX(v: int)      { this.X = v }
    public void SetY(v: int)      { this.Y = v }
    public void SetButton(v: int) { this.Button = v }
    public void SetMods(v: int)   { this.Mods = v }
    public void SetW(v: int)      { this.W = v }
    public void SetH(v: int)      { this.H = v }
}

// ─── Font ──────────────────────────────────────────────
// Declared before Window because Window.DrawText takes a Font
// parameter, and the cgen emits classes in source order — Font's
// typedef must be complete before Window's methods reference it.

public class Font {
    public Handle: int   // (intptr_t)AmalgameUIFont*
    public Size: int

    public Font() {
        this.Handle = 0
        this.Size = 0
    }

    public int  GetHandle()       { return this.Handle }
    public void SetHandle(h: int) { this.Handle = h }
    public int  GetSize()         { return this.Size }

    // Load a TTF font from disk. Returns null on failure (missing
    // file, unsupported format, TTF_Init failure).
    public static Font Load(path: string, size: int) {
        let f: Font = new Font()
        f.Size = size
        let handle: int = 0
        @c {
            AmalgameUIFont* _h = Amalgame_UI_loadFont(path, size);
            if (!_h) return NULL;
            handle = (i64)(intptr_t)_h;
        }
        f.SetHandle(handle)
        return f
    }

    public void Destroy() {
        @c {
            Amalgame_UI_destroyFont((AmalgameUIFont*)(intptr_t)self->Handle);
        }
        this.Handle = 0
    }

    // Returns the rendered width (in pixels) for `text` at this
    // font's size. Convenience wrapper that drops the height.
    public int MeasureWidth(text: string) {
        @c {
            int w = 0, h = 0;
            Amalgame_UI_measureText((AmalgameUIFont*)(intptr_t)self->Handle, text, &w, &h);
            return w;
        }
    }

    public int MeasureHeight(text: string) {
        @c {
            int w = 0, h = 0;
            Amalgame_UI_measureText((AmalgameUIFont*)(intptr_t)self->Handle, text, &w, &h);
            return h;
        }
    }
}

// ─── Window ────────────────────────────────────────────

public class Window {
    // Opaque AmalgameUIWindow* stored as int64. Inspected only
    // from @c blocks; consumer code never reads this directly.
    public Handle: int

    public Window() {
        this.Handle = 0
    }

    public void SetHandle(h: int) { this.Handle = h }

    // Open a new resizable window. Returns null on failure
    // (e.g. SDL_Init fails, no DISPLAY on Linux, etc.).
    public static Window New(title: string, width: int, height: int) {
        let w: Window = new Window()
        let handle: int = 0
        @c {
            AmalgameUIWindow* _h = Amalgame_UI_Window_new(title, width, height);
            if (!_h) return NULL;
            handle = (i64)(intptr_t)_h;
        }
        w.SetHandle(handle)
        return w
    }

    public void Close() {
        @c {
            Amalgame_UI_Window_close((AmalgameUIWindow*)(intptr_t)self->Handle);
        }
    }

    public bool ShouldClose() {
        @c {
            return Amalgame_UI_Window_should_close((AmalgameUIWindow*)(intptr_t)self->Handle);
        }
    }

    public int Width() {
        @c {
            return Amalgame_UI_Window_width((AmalgameUIWindow*)(intptr_t)self->Handle);
        }
    }

    public int Height() {
        @c {
            return Amalgame_UI_Window_height((AmalgameUIWindow*)(intptr_t)self->Handle);
        }
    }

    public void SetTitle(title: string) {
        @c {
            Amalgame_UI_Window_set_title((AmalgameUIWindow*)(intptr_t)self->Handle, title);
        }
    }

    // Non-blocking event poll. Returns a fresh Event; .Kind = 0
    // (EventKind.NONE) when the queue is empty. Suitable for
    // game-style render loops.
    public Event Poll() {
        let ev: Event = new Event()
        let kind: int = 0
        let x: int = 0
        let y: int = 0
        let btn: int = 0
        let mods: int = 0
        let w: int = 0
        let h: int = 0
        @c {
            AmalgameUIEvent _e;
            Amalgame_UI_pollEvent((AmalgameUIWindow*)(intptr_t)self->Handle, &_e);
            kind = _e.kind;
            x    = _e.x;
            y    = _e.y;
            btn  = _e.button;
            mods = _e.mods;
            w    = _e.w;
            h    = _e.h;
        }
        ev.SetKind(kind)
        ev.SetX(x)
        ev.SetY(y)
        ev.SetButton(btn)
        ev.SetMods(mods)
        ev.SetW(w)
        ev.SetH(h)
        return ev
    }

    // Blocking. Used by Forms' Application.Run() so the CPU stays
    // idle between user interactions.
    public Event Wait() {
        let ev: Event = new Event()
        let kind: int = 0
        let x: int = 0
        let y: int = 0
        let btn: int = 0
        let mods: int = 0
        let w: int = 0
        let h: int = 0
        @c {
            AmalgameUIEvent _e;
            Amalgame_UI_waitEvent((AmalgameUIWindow*)(intptr_t)self->Handle, &_e);
            kind = _e.kind;
            x    = _e.x;
            y    = _e.y;
            btn  = _e.button;
            mods = _e.mods;
            w    = _e.w;
            h    = _e.h;
        }
        ev.SetKind(kind)
        ev.SetX(x)
        ev.SetY(y)
        ev.SetButton(btn)
        ev.SetMods(mods)
        ev.SetW(w)
        ev.SetH(h)
        return ev
    }

    // ─── Drawing ──────────────────────────────────────
    //
    // Stage every Color/Rect field through Get* into a local int
    // before the @c block. Direct `c->R` / `r->X` inside @c
    // requires the struct to be complete in the surrounding TU,
    // which doesn't hold in the multi-namespace `amc -o test.am
    // facade.am` compilation path (forward-decl in scope, full
    // typedef defined later in the same file).

    public void Clear(c: Color) {
        let cr: int = c.GetR()
        let cg: int = c.GetG()
        let cb: int = c.GetB()
        @c {
            Amalgame_UI_clear((AmalgameUIWindow*)(intptr_t)self->Handle, cr, cg, cb);
        }
    }

    public void Present() {
        @c {
            Amalgame_UI_present((AmalgameUIWindow*)(intptr_t)self->Handle);
        }
    }

    public void FillRect(r: Rect, c: Color) {
        let rx: int = r.GetX()
        let ry: int = r.GetY()
        let rw: int = r.GetW()
        let rh: int = r.GetH()
        let cr: int = c.GetR()
        let cg: int = c.GetG()
        let cb: int = c.GetB()
        let ca: int = c.GetA()
        @c {
            Amalgame_UI_fillRect((AmalgameUIWindow*)(intptr_t)self->Handle,
                                 rx, ry, rw, rh, cr, cg, cb, ca);
        }
    }

    public void DrawRect(r: Rect, c: Color) {
        let rx: int = r.GetX()
        let ry: int = r.GetY()
        let rw: int = r.GetW()
        let rh: int = r.GetH()
        let cr: int = c.GetR()
        let cg: int = c.GetG()
        let cb: int = c.GetB()
        let ca: int = c.GetA()
        @c {
            Amalgame_UI_drawRect((AmalgameUIWindow*)(intptr_t)self->Handle,
                                 rx, ry, rw, rh, cr, cg, cb, ca);
        }
    }

    public void DrawLine(x1: int, y1: int, x2: int, y2: int, c: Color) {
        let cr: int = c.GetR()
        let cg: int = c.GetG()
        let cb: int = c.GetB()
        let ca: int = c.GetA()
        @c {
            Amalgame_UI_drawLine((AmalgameUIWindow*)(intptr_t)self->Handle,
                                 x1, y1, x2, y2, cr, cg, cb, ca);
        }
    }

    public void DrawPixel(x: int, y: int, c: Color) {
        let cr: int = c.GetR()
        let cg: int = c.GetG()
        let cb: int = c.GetB()
        let ca: int = c.GetA()
        @c {
            Amalgame_UI_drawPixel((AmalgameUIWindow*)(intptr_t)self->Handle,
                                  x, y, cr, cg, cb, ca);
        }
    }

    public void DrawText(f: Font, text: string, x: int, y: int, c: Color) {
        let fh: int = f.GetHandle()
        let cr: int = c.GetR()
        let cg: int = c.GetG()
        let cb: int = c.GetB()
        let ca: int = c.GetA()
        @c {
            Amalgame_UI_drawText((AmalgameUIWindow*)(intptr_t)self->Handle,
                                 (AmalgameUIFont*)(intptr_t)fh,
                                 text, (int)x, (int)y,
                                 (int)cr, (int)cg, (int)cb, (int)ca);
        }
    }
}

